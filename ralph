#!/usr/bin/env bash
# ralph — Autonomous task executor. Loops Claude Code over beads issues.
#
# Deterministic outer loop. All intelligence lives in Claude Code (inner loop).
# See PHILOSOPHY.md for why this is a bash script and not a framework.
#
# Usage: ralph [--dry-run] [--max-tasks N] [--max-loops N] [--timeout M]
#              [--model MODEL] [--scope PATTERN] [--playlist FILE]
#              [--sandbox] [--monitor] [--tmux] [--remote [HOST]]
#              [--status] [--reset] [-h|--help]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/loader.sh
source "$SCRIPT_DIR/lib/loader.sh"
initialize "$@"

# ── Main loop ───────────────────────────────────────────────────────────────
if [[ -n "$PLAYLIST" ]]; then
    # ── Playlist mode ──────────────────────────────────────────────────────
    while true; do
        check_exit_conditions    || break
        playlist_next            || { EXIT_REASON="Playlist complete"; break; }
        playlist_handle_dry_run  && continue
        playlist_execute         || break
        save_state
    done

    if [[ "$DRY_RUN" == "true" ]]; then
        playlist_dry_run_summary
        EXIT_REASON="Dry run complete"
    fi
else
    # ── Standard br-ready mode ─────────────────────────────────────────────
    while true; do
        check_exit_conditions || break
        select_task           || break
        handle_dry_run        && break
        log ""
        log "═══════════════════════════════════════════════════════"
        log "  LOOP $((total_loops + 1))/$MAX_LOOPS  │  Task: $tid  │  Model: $MODEL"
        log "═══════════════════════════════════════════════════════"
        log ""
        claim_task "$tid"
        build_prompt "$tid" "$task_details"
        invoke_claude         || break
        check_bead_status "$tid"
        update_circuit_breaker
        handle_task_outcome "$tid"
        save_state
    done
fi
save_state
exit "$(exit_code_for_reason)"
